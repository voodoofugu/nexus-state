{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es2021"],
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@nexus-state/src/*": ["../src/*"]
    }
  },
  "include": ["src", "plugins", "../vite.config.ts"]
}
